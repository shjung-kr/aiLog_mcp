# aiLog MCP Server 환경설정
# 이 파일을 .env 로 복사한 뒤 값을 채워주세요

# aiLog와 공유하는 PostgreSQL DB
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ailog

# OpenAI API (에피소드 검색용 임베딩 + 큐레이션)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 마지막 메시지 후 이 시간(초)이 지나면 에피소드 자동 빌드
EPISODE_IDLE_SECONDS=60
